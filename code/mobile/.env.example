# Supabase — from Project Settings -> API (the anon key is safe to ship in the app)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Backend (NestJS). Use your Mac's LAN IP, not localhost, when testing on a real phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
