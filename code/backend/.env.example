# Supabase — Project Settings -> API. NEVER commit the real service role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ID_CARD_BUCKET=id-cards

PORT=3000

# Optional — when you deploy
# CORS_ORIGINS=https://your-admin-site.example   browser sites allowed to call the API (the phone app doesn't need this)
# TRUST_PROXY=1     behind a hosting proxy, so rate limits see the student's IP
